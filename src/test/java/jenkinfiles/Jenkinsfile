#!groovy encoding: UTF-8

package jenkinfiles

pipeline {
    agent any

    environment {
        // путь к Java на localhost
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-17'
        BASE_URL = 'https://www.championat.com/'
        BROWSER = 'chrome'
    }

    triggers {
        pollSCM('H/5 * * * *') // Проверять изменения каждые 5 минут
    }

    stages {
        stage('Подготовка') {
            steps {
                echo 'Клонирование репозитория и настройка окружения...'
                cleanWs()

                // Для локального тестирования можно использовать SSH URL
                git(
                        branch: 'master',
                        //url: 'git@github.com:AlexanderSchulga/TestChampionatJenkins.git',
                        url: 'https://github.com/AlexanderSchulga/TestChampionatJenkins.git',
                        credentialsId: 'github-credentials'
                )
            }
        }

        stage('Запуск тестов') {
            steps {
                echo 'Запуск UI-тестов с Selenide и Cucumber...'
                bat 'mvn clean test -X'
            }
            post {
                always {
                    // Ищем отчеты в правильных местах
                    junit '**/target/surefire-reports/**/*.xml'
                    cucumber '**/target/cucumber-reports/**/*.json'
                    archiveArtifacts artifacts: '**/target/**/*.*', allowEmptyArchive: true

                    // Сохраняем логи тестов
                    archiveArtifacts artifacts: '**/target/surefire-reports/*.txt', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline завершен. Результат: ${currentBuild.result}"

            // Для локального тестирования уведомление в консоль
            script {
                if (currentBuild.result == 'SUCCESS') {
                    echo 'Тесты прошли успешно!'
                } else {
                    echo 'Обнаружены ошибки в тестах!'
                }
            }
        }
    }
}
